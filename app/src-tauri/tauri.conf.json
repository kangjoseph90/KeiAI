{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "KeiAI",
    "version": "0.1.0",
    "identifier": "com.kei.ai",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "KeiAI",
                "width": 800,
                "height": 600,
                "minWidth": 360,
                "minHeight": 480,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/assets/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": {
            "../public/token/**/*": "token/"
        }
    }
}
