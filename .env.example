# KeiAI Environment Variables Template
# Copy this file to .env and fill in your values.

# 🌐 Frontend (app)
# Prefix with VITE_ to expose them to the client browser environment.

# URL of the PocketBase API server the frontend should connect to.
VITE_PB_URL=http://127.0.0.1:8090
# The endpoint of your Cloudflare Worker fetch proxy.
VITE_PROXY_URL=http://127.0.0.1:8787

# 🛡️ Proxy (proxy)
# Configured via proxy/.dev.vars (local) or Cloudflare Dashboard secrets (production).
# See proxy/AGENTS.md for details.

# 🗄️ PocketBase (pocketbase)
# These are used by the PocketBase startup script and hooks.

# Admin email used to automatically create/update the superuser on first run.
PB_ADMIN_EMAIL=admin@example.com
# Admin password used to automatically create/update the superuser on first run.
PB_ADMIN_PASSWORD=change_me_strong_password
# Secret key used to generate deterministic dummy salts to prevent email enumeration.
DUMMY_SALT_SECRET=change_me_random_32_char_secret!!
# The host address the PocketBase server should bind to.
PB_HOST=127.0.0.1
# The port number the PocketBase server should listen on.
PB_PORT=8090
# The default file storage quota for new users (in bytes). Default: 52428800 (50MB).
DEFAULT_ASSET_QUOTA_BYTES=52428800
# Optional username whitelist for self-hosted servers.
# Leave empty/unset to allow all usernames. Supports comma or whitespace separated values.
# PB_ALLOWED_USERNAMES=kei,friend

# Optional Cloudflare R2 / S3-compatible asset storage.
# When all required values are set, asset ciphertext is stored at assets/{hash}.bin.
# Leave empty to use PocketBase's built-in file storage.
# R2_BUCKET=<bucket>
# R2_REGION=auto
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_FORCE_PATH_STYLE=true
